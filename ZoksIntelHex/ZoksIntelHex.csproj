<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <DefaultLanguage>de-DE</DefaultLanguage>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <LangVersion>8</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PackageId>ZoksIntelHex</PackageId>
    <Version>2.0.0</Version>
    <Authors>Andre Zoledziowski</Authors>
    <Company>Andre Zoledziowski</Company>
    <PackageProjectUrl>https://github.com/ZokRadonh/ZoksIntelHex</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Supports read and write operations in IntelHex files</Description>
    <Copyright>Copyright MIT © 2026</Copyright>
    <PackageTags>hex ihex intel file read write</PackageTags>
    <PackageReleaseNotes>Version 2.0.0</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>